---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Icon } from '@/components/ui/icon';
import { formatDate, TRANSCRIPTS_SECTION } from '../../lib/categories';
import { youtubeId, isoDuration } from '../../lib/video';
import { sourceLabels } from '../../lib/source';
import Tldr from '../../components/transcript/Tldr.astro';
import AudioDigest from '../../components/transcript/AudioDigest.astro';
import PlainSpeak from '../../components/transcript/PlainSpeak.astro';
import Ratings from '../../components/transcript/Ratings.astro';
import Professions from '../../components/transcript/Professions.astro';
import VideoEmbed from '../../components/transcript/VideoEmbed.astro';
import Chapters from '../../components/transcript/Chapters.astro';
import TagChips from '../../components/transcript/TagChips.astro';
import Insights from '../../components/transcript/Insights.astro';
import Quotes from '../../components/transcript/Quotes.astro';
import Tips from '../../components/transcript/Tips.astro';
import UserStories from '../../components/transcript/UserStories.astro';
import Flowchart from '../../components/transcript/Flowchart.astro';
import Plan from '../../components/transcript/Plan.astro';
import Quiz from '../../components/transcript/Quiz.astro';
import Glossary from '../../components/transcript/Glossary.astro';
import Collapsible from '../../components/transcript/Collapsible.astro';
import Critique from '../../components/transcript/Critique.astro';
import ThinkDifferent from '../../components/transcript/ThinkDifferent.astro';
import RelatedArticles from '../../components/transcript/RelatedArticles.astro';
import SectionHeading from '../../components/transcript/SectionHeading.astro';
import TranscriptNav from '../../components/transcript/TranscriptNav.astro';

export async function getStaticPaths() {
  const posts = await getCollection('transcripts', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const hasBody = (post.body ?? '').trim().length > 0;

// Похожие: сперва указанные явно, потом — по совпадению тегов
const all = await getCollection('transcripts', ({ data }) => import.meta.env.DEV || !data.draft);
const byId = new Map(all.map((e) => [e.id, e]));
const explicit = (d.related ?? []).map((id) => byId.get(id)).filter((e) => e && e.id !== post.id);
const explicitIds = new Set(explicit.map((e) => e!.id));
const suggestions = all
  .filter((e) => e.id !== post.id && !explicitIds.has(e.id))
  .map((e) => ({ e, overlap: e.data.tags.filter((t) => d.tags.includes(t)).length }))
  .filter((x) => x.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || b.e.data.date.valueOf() - a.e.data.date.valueOf())
  .map((x) => x.e);
const related = [...explicit, ...suggestions]
  .slice(0, 4)
  .map((e) => ({ href: `/transcripts/${e!.id}/`, title: e!.data.title, tldr: e!.data.tldr }));

const ogImage = d.cover && !d.cover.endsWith('.svg') ? d.cover : undefined;

// Универсальные подписи источника (видео/подкаст/статья/разбор) — см. lib/source.ts
const src = sourceLabels(d.video);

const hasAudio = Boolean(d.audio?.src);
const hasPlain = Boolean(d.plain || d.forKids || d.analogy || d.whyImportant || d.forExperts);
const hasInsights = Boolean(d.insights?.length);
const hasQuotes = Boolean(d.quotes?.length);
const hasTips = Boolean(d.tips?.length);
const hasStories = Boolean(d.userStories?.length);
const hasFlow = Boolean(d.flowchart?.length);
const hasPlan = Boolean(d.plan?.length);
const hasQuiz = Boolean(d.quiz?.length);
const hasGlossary = Boolean(d.glossary?.length);
const hasProfessions = Boolean(d.professions?.length);
const hasCritique = Boolean(d.critique?.length);
const hasThinkDifferent = Boolean(d.thinkDifferent?.length);

// Оглавление — только присутствующие секции
const toc = [
  { id: 'tldr', label: 'Коротко', on: true },
  { id: 'audio', label: 'Выжимка', on: hasAudio },
  { id: 'plain', label: 'Простыми словами', on: hasPlain },
  { id: 'ratings', label: 'Оценки', on: true },
  { id: 'professions', label: 'Кому полезно', on: hasProfessions },
  { id: 'insights', label: 'Инсайты', on: hasInsights },
  { id: 'quotes', label: 'Цитаты', on: hasQuotes },
  { id: 'tips', label: 'Советы', on: hasTips },
  { id: 'stories', label: 'Сценарии', on: hasStories },
  { id: 'flow', label: 'Логика', on: hasFlow },
  { id: 'body', label: 'Разбор', on: hasBody },
  { id: 'plan', label: 'План', on: hasPlan },
  { id: 'quiz', label: 'Тест', on: hasQuiz },
  { id: 'glossary', label: 'Словарь', on: hasGlossary },
  { id: 'critique', label: 'Критика', on: hasCritique },
  { id: 'think-different', label: 'Иначе', on: hasThinkDifferent },
].filter((s) => s.on).map(({ id, label }) => ({ id, label }));

// Структурированная разметка schema.org
const ytId = youtubeId(d.video.url);
const abs = (p?: string) => (p ? new URL(p, Astro.site).toString() : undefined);
const thumb =
  abs(ogImage) ?? (ytId ? `https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg` : undefined);
const pageUrl = new URL(`/transcripts/${post.id}/`, Astro.site).toString();

const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: d.video.title || d.title,
  description: d.description,
  thumbnailUrl: thumb,
  uploadDate: d.video.published?.toISOString(),
  duration: d.video.durationSeconds ? isoDuration(d.video.durationSeconds) : undefined,
  contentUrl: d.video.url,
  embedUrl: ytId ? `https://www.youtube.com/embed/${ytId}` : undefined,
};
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  image: thumb ? [thumb] : undefined,
  inLanguage: 'ru',
  author: { '@type': 'Organization', name: 'neuro-slop.ru' },
  publisher: { '@type': 'Organization', name: 'neuro-slop.ru' },
  mainEntityOfPage: pageUrl,
};
const faqLd = hasQuiz
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.quiz!.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${q.options[q.answer]}. ${q.correctText}`,
        },
      })),
    }
  : null;
const jsonLd = [videoLd, articleLd, faqLd].filter(Boolean);
---

<Layout title={`${d.title} — Neuro Slop`} description={d.description} image={ogImage} jsonLd={jsonLd}>
  <TranscriptNav items={toc} />
  <main class="mx-auto w-full max-w-[860px] px-5 pt-16 md:px-6">
    <article>
      <header class="mb-12">
        <p class="text-muted-foreground flex flex-wrap items-center gap-2 text-sm">
          <a
            href="/transcripts/"
            class="hover:text-foreground inline-flex items-center gap-1.5 font-semibold transition-colors"
          >
            <Icon name={TRANSCRIPTS_SECTION.icon} class="size-4" />
            {TRANSCRIPTS_SECTION.label}
          </a>
          <span>·</span>
          <span>
            Статья: <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          </span>
          {d.video.published && (
            <>
              <span>·</span>
              <span>
                {src.dateLabel}: <time datetime={d.video.published.toISOString()}>{formatDate(d.video.published)}</time>
              </span>
            </>
          )}
          {d.video.duration && (
            <>
              <span>·</span>
              <span>{d.video.duration}</span>
            </>
          )}
        </p>

        <h1 class="mt-4 text-[clamp(2.1rem,5vw,3.25rem)] leading-[1.06] font-bold tracking-[-0.03em] text-balance">
          {d.title}
        </h1>
        <p class="text-muted-foreground mt-5 text-xl leading-relaxed font-medium">{d.description}</p>

        <div class="mt-6">
          <TagChips tags={d.tags} variant="link" />
        </div>
      </header>

      <div class="space-y-16">
        <div>
          <VideoEmbed
            url={d.video.url}
            title={d.video.title}
            channel={d.video.channel}
            duration={d.video.duration}
            cover={d.cover}
            playLabel={src.play}
            playAria={src.playAria}
            icon={src.icon}
          />
          {d.chapters && d.chapters.length > 0 && <Chapters chapters={d.chapters} url={d.video.url} label={src.chaptersLabel} />}
        </div>

        <div id="tldr" class="scroll-mt-24">
          <Tldr text={d.tldr} />
        </div>

        {
          hasAudio && (
            <div id="audio" class="scroll-mt-24">
              <AudioDigest
                src={d.audio!.src}
                duration={d.audio!.duration}
                voice={d.audio!.voice}
                script={d.audio!.script}
              />
            </div>
          )
        }

        {
          hasPlain && (
            <div id="plain" class="scroll-mt-24">
              <PlainSpeak
                plain={d.plain}
                forKids={d.forKids}
                analogy={d.analogy}
                whyImportant={d.whyImportant}
                forExperts={d.forExperts}
              />
            </div>
          )
        }

        <div id="ratings" class="scroll-mt-24">
          <Ratings ratings={d.ratings} title={src.ratingsTitle} />
        </div>

        {
          hasProfessions && (
            <div id="professions" class="scroll-mt-24">
              <Professions professions={d.professions!} />
            </div>
          )
        }

        {
          hasInsights && (
            <div id="insights" class="scroll-mt-24">
              <Insights insights={d.insights!} url={d.video.url} />
            </div>
          )
        }

        {
          hasQuotes && (
            <div id="quotes" class="scroll-mt-24">
              <Quotes quotes={d.quotes!} url={d.video.url} hint={src.quotesHint} />
            </div>
          )
        }

        {
          hasTips && (
            <div id="tips" class="scroll-mt-24">
              <Tips tips={d.tips!} />
            </div>
          )
        }

        {
          hasStories && (
            <div id="stories" class="scroll-mt-24">
              <UserStories stories={d.userStories!} />
            </div>
          )
        }

        {
          hasFlow && (
            <div id="flow" class="scroll-mt-24">
              <Flowchart nodes={d.flowchart!} url={d.video.url} hint={src.flowchartHint} />
            </div>
          )
        }

        {
          hasBody && (
            <section id="body" class="scroll-mt-24">
              <SectionHeading
                icon="scroll-text"
                title="Подробный разбор"
                hint="Полный разбор — разверни, если нужно глубже"
              />
              <Collapsible label="Развернуть подробный разбор" openLabel="Свернуть подробный разбор">
                <div class="prose">
                  <Content />
                </div>
              </Collapsible>
            </section>
          )
        }

        {
          hasPlan && (
            <div id="plan" class="scroll-mt-24">
              <Plan steps={d.plan!} storageKey={post.id} />
            </div>
          )
        }

        {
          hasQuiz && (
            <div id="quiz" class="scroll-mt-24">
              <Quiz quiz={d.quiz!} />
            </div>
          )
        }

        {
          hasGlossary && (
            <div id="glossary" class="scroll-mt-24">
              <Glossary terms={d.glossary!} />
            </div>
          )
        }

        {
          hasCritique && (
            <div id="critique" class="scroll-mt-24">
              <Critique points={d.critique!} />
            </div>
          )
        }

        {
          hasThinkDifferent && (
            <div id="think-different" class="scroll-mt-24">
              <ThinkDifferent ideas={d.thinkDifferent!} />
            </div>
          )
        }

        <RelatedArticles items={related} />
      </div>

      <div class="border-border/60 mt-16 flex flex-wrap items-center justify-between gap-4 border-t pt-8">
        <a href="/transcripts/" class="text-primary text-sm font-medium hover:underline">
          ← Все разборы
        </a>
        <a
          href={d.video.url}
          target="_blank"
          rel="noopener"
          class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
        >
          {src.sourceLink}
          <Icon name="arrow-up-right" class="size-4" />
        </a>
      </div>
    </article>
  </main>
</Layout>
