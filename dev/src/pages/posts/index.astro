---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import TranscriptCard from '../../components/TranscriptCard.astro';
import { SECTIONS } from '../../lib/categories';
import { Icon } from '@/components/ui/icon';

const visible = ({ data }: { data: { draft: boolean } }) => import.meta.env.DEV || !data.draft;
const posts = await getCollection('posts', visible);
const transcripts = await getCollection('transcripts', visible);

// Все записи из всех разделов, включая расшифровки, — по дате (свежие первыми)
const entries = [
  ...posts.map((entry) => ({ type: 'post' as const, date: entry.data.date, entry })),
  ...transcripts.map((entry) => ({ type: 'transcript' as const, date: entry.data.date, entry })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Layout title="Записи — Neuro Slop">
  <main class="mx-auto w-full max-w-[1440px] px-5 pt-16 md:px-10">
    <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] font-bold tracking-[-0.03em]">Записи</h1>

    <div class="mt-7 mb-10 flex flex-wrap gap-2">
      {
        SECTIONS.map((section) => (
          <a
            class="bg-card/60 border-border/60 text-foreground/90 hover:border-primary/50 hover:text-foreground inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm font-medium backdrop-blur-sm transition-colors"
            href={section.href}
          >
            <Icon name={section.icon} class="size-4" />
            {section.label}
          </a>
        ))
      }
    </div>

    <div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
      {
        entries.map((item) =>
          item.type === 'post' ? (
            <PostCard post={item.entry} />
          ) : (
            <TranscriptCard entry={item.entry} />
          )
        )
      }
    </div>
  </main>
</Layout>
