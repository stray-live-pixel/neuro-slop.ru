---
// Универсальная комната чата: одна на всех ботов раздела /chats/.
// Стримит ответ по SSE с тонкого сервера, рендерит markdown (с санитайзом),
// держит лимит сообщений и счётчик «сэкономлено». Чтобы добавить нового бота —
// заведи md-файл в src/content/chats/ и серверный промпт; этот компонент не меняется.
import { Icon } from '@/components/ui/icon';
import { accentOf } from '../../lib/chats';

interface Bot {
  botId: string;
  icon?: string;
  maxMessages: number;
  greeting: string;
  placeholder: string;
  starters: string[];
  counter: { enabled: boolean; label: string; unit: string };
  accent?: string;
}
interface Props {
  bot: Bot;
  apiBase: string;
}

const { bot, apiBase } = Astro.props;
const accent = accentOf(bot.accent);

// Конфиг для клиентского скрипта (только публичные значения).
const config = {
  apiBase,
  botId: bot.botId,
  maxMessages: bot.maxMessages,
  greeting: bot.greeting,
  counter: bot.counter,
};
---

<section
  class="glow-card bg-card/60 border-border/60 relative flex flex-col overflow-hidden rounded-3xl border backdrop-blur-sm"
  data-chat
  style={`--bot-accent: ${accent}`}
>
  <script type="application/json" data-chat-config is:inline set:html={JSON.stringify(config)} />

  <!-- Иконки карточек-развязок (клонируются в JS) -->
  <template data-saved-icon><Icon name="piggy-bank" class="size-6" /></template>
  <template data-stand-icon><Icon name="rocket" class="size-6" /></template>

  <!-- Холст для конфетти (поверх чата, не ловит клики) -->
  <canvas class="chat-confetti" data-confetti aria-hidden="true"></canvas>

  <!-- Лента сообщений -->
  <div class="chat-scroll" data-messages>
    <div class="chat-msg chat-msg--assistant">
      <div class="chat-avatar" style={`background:${accent}`}>
        <Icon name={bot.icon ?? 'bot'} class="size-4" />
      </div>
      <div class="chat-bubble" set:text={bot.greeting} />
    </div>
  </div>

  <!-- Подсказки-стартеры -->
  {
    bot.starters.length > 0 && (
      <div class="chat-starters" data-starters>
        <span class="chat-starters__hint">Попробуй с примера:</span>
        <div class="chat-starters__row">
          {bot.starters.map((s) => (
            <button type="button" class="chat-starter" data-starter={s}>
              {s}
            </button>
          ))}
        </div>
      </div>
    )
  }

  <!-- Лимит сообщений -->
  <div class="chat-limit" data-limit hidden>
    <p>Лимит в {bot.maxMessages} сообщений на сессию исчерпан — так задумано, чтобы бот не разорял создателя 🙂</p>
    <button type="button" class="chat-restart" data-restart>
      <Icon name="refresh-cw" class="size-4" />
      Начать заново
    </button>
  </div>

  <!-- Поле ввода -->
  <form class="chat-composer" data-form>
    <textarea
      class="chat-input"
      data-input
      rows="1"
      maxlength="1000"
      placeholder={bot.placeholder}
      autocomplete="off"
      aria-label="Сообщение боту"></textarea>
    <button type="submit" class="chat-send" data-send aria-label="Отправить">
      <Icon name="send-horizontal" class="size-5" />
    </button>
  </form>

  <p class="chat-hint">
    <span>Enter — отправить, Shift+Enter — перенос строки</span>
    <span>Осталось сообщений: <b data-remaining>{bot.maxMessages}</b></span>
  </p>

</section>

<style is:global>
  [data-chat] {
    --chat-radius: 1.5rem;
  }
  .chat-scroll {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    overflow-y: auto;
    padding: 1.25rem 1.25rem 0.5rem;
    min-height: 360px;
    max-height: min(62vh, 620px);
    scroll-behavior: smooth;
    overscroll-behavior: contain;
  }
  /* Элементы ленты не сжимаются по высоте — иначе текст карточек обрезается */
  .chat-scroll > * { flex-shrink: 0; }
  .chat-msg {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }
  .chat-msg--user {
    justify-content: flex-end;
  }
  .chat-msg--assistant {
    justify-content: flex-start;
  }
  .chat-msg--system {
    justify-content: center;
  }
  .chat-avatar {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    color: #fff;
    box-shadow: var(--shadow-sm);
  }
  .chat-bubble {
    max-width: min(85%, 60ch);
    padding: 0.7rem 1rem;
    border-radius: 1.15rem;
    font-size: 16px;
    line-height: 1.5;
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .chat-msg--assistant .chat-bubble {
    background: var(--secondary);
    color: var(--secondary-foreground);
    border-bottom-left-radius: 0.35rem;
  }
  .chat-msg--user .chat-bubble {
    background: var(--primary);
    color: var(--primary-foreground);
    border-bottom-right-radius: 0.35rem;
  }
  .chat-msg--system .chat-bubble {
    background: transparent;
    color: var(--muted-foreground);
    font-size: 13px;
    text-align: center;
    padding: 0.25rem 0.5rem;
    max-width: 46ch;
  }
  .chat-bubble.is-error {
    background: color-mix(in oklch, var(--destructive) 14%, var(--card));
    color: var(--foreground);
  }
  .chat-bubble > :first-child { margin-top: 0; }
  .chat-bubble > :last-child { margin-bottom: 0; }
  .chat-bubble p { margin: 0.4rem 0; }
  .chat-bubble ul,
  .chat-bubble ol { margin: 0.4rem 0; padding-left: 1.2rem; }
  .chat-bubble ul { list-style: disc; }
  .chat-bubble ol { list-style: decimal; }
  .chat-bubble li { margin: 0.15rem 0; }
  .chat-bubble strong { font-weight: 650; }
  .chat-bubble code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 6px;
  }

  /* Индикатор «печатает» */
  .chat-typing {
    display: inline-flex;
    gap: 4px;
    padding: 0.15rem 0;
  }
  .chat-typing i {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.4;
    animation: chat-blink 1.2s infinite ease-in-out both;
  }
  .chat-typing i:nth-child(2) { animation-delay: 0.18s; }
  .chat-typing i:nth-child(3) { animation-delay: 0.36s; }
  @keyframes chat-blink {
    0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-3px); }
  }

  /* Карточка «сэкономлено» — матовое градиентное стекло */
  .chat-saved {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1rem auto 0.5rem;
    padding: 0.95rem 1.1rem;
    max-width: 94%;
    border-radius: 1.25rem;
    color: var(--foreground);
    overflow: hidden;
    background-color: color-mix(in oklch, var(--card) 55%, transparent);
    background-image: linear-gradient(
      110deg,
      color-mix(in oklch, #0894ff 20%, transparent),
      color-mix(in oklch, #c959dd 18%, transparent) 45%,
      color-mix(in oklch, #ff2e54 13%, transparent) 72%,
      color-mix(in oklch, #ff9004 18%, transparent)
    );
    background-size: 220% 220%;
    border: 1px solid color-mix(in oklch, white 22%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, white 24%, transparent),
      var(--shadow-lg);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    animation:
      chat-saved-pop 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both,
      chat-saved-shift 11s ease-in-out infinite;
  }
  .chat-saved__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    color: #fff;
    background: var(--gradient-brand);
    box-shadow: 0 6px 16px -6px color-mix(in oklch, #c959dd 60%, transparent);
  }
  /* min-width:0 — чтобы длинный заголовок переносился, а не вылезал за карточку */
  .chat-saved > div:last-child { min-width: 0; }
  .chat-saved__title {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .chat-saved__note { color: var(--muted-foreground); font-size: 14px; margin-top: 0.2rem; }

  /* Развязка «остался при своём»: тёплый энергичный акцент в иконке-ракете */
  .chat-saved--stand .chat-saved__icon {
    background: linear-gradient(135deg, #ff9004, #ff2e54);
  }

  /* Холст конфетти — поверх ленты, не ловит клики */
  .chat-confetti {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }

  @keyframes chat-saved-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  @keyframes chat-saved-pop {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }

  .chat-starters {
    padding: 0.25rem 1.25rem 0.75rem;
  }
  .chat-starters__hint {
    display: block;
    font-size: 13px;
    color: var(--muted-foreground);
    margin-bottom: 0.5rem;
  }
  .chat-starters__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chat-starter {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-size: 14px;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.1s ease;
  }
  .chat-starter:hover { border-color: color-mix(in oklch, var(--primary) 55%, transparent); }
  .chat-starter:active { transform: scale(0.97); }

  .chat-limit {
    margin: 0 1.25rem 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 1rem;
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: 14px;
    text-align: center;
  }
  .chat-restart {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.6rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
  }

  .chat-composer {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--border);
    background: color-mix(in oklch, var(--card) 70%, transparent);
  }
  .chat-input {
    flex: 1 1 auto;
    resize: none;
    max-height: 160px;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    border-radius: 1.1rem;
    padding: 0.7rem 0.95rem;
    font: inherit;
    font-size: 16px;
    line-height: 1.45;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .chat-input:focus { border-color: color-mix(in oklch, var(--primary) 60%, transparent); }
  .chat-input:disabled { opacity: 0.55; cursor: not-allowed; }
  .chat-send {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.85rem;
    height: 2.85rem;
    border-radius: 999px;
    background: var(--bot-accent, var(--primary));
    color: #fff;
    cursor: pointer;
    transition: transform 0.1s ease, opacity 0.2s ease;
  }
  .chat-send:hover:not(:disabled) { transform: translateY(-1px); }
  .chat-send:active:not(:disabled) { transform: scale(0.94); }
  .chat-send:disabled { opacity: 0.45; cursor: not-allowed; }
  .chat-send.is-loading { opacity: 0.6; }

  .chat-hint {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 1.1rem 0.9rem;
    font-size: 12px;
    color: var(--muted-foreground);
  }

  /* ===== Мобильные уточнения ===== */
  @media (max-width: 640px) {
    [data-chat] { border-radius: 1.25rem; }
    .chat-scroll {
      padding: 0.85rem 0.85rem 0.4rem;
      min-height: 300px;
      max-height: 64dvh;
    }
    .chat-msg { gap: 0.45rem; margin-top: 0.6rem; }
    .chat-avatar { width: 1.7rem; height: 1.7rem; }
    .chat-bubble {
      max-width: 88%;
      font-size: 15.5px;
      padding: 0.6rem 0.85rem;
    }
    .chat-starters,
    .chat-limit { margin-left: 0.85rem; margin-right: 0.85rem; }
    .chat-starters { padding-left: 0.85rem; padding-right: 0.85rem; }
    .chat-composer { padding: 0.65rem 0.7rem; gap: 0.5rem; }
    .chat-input { padding: 0.6rem 0.8rem; border-radius: 0.95rem; }
    .chat-send { width: 2.6rem; height: 2.6rem; }
    .chat-hint {
      padding: 0 0.85rem 0.75rem;
      font-size: 11.5px;
      gap: 0.15rem 0.75rem;
    }
    .chat-saved { gap: 0.7rem; padding: 0.85rem 0.95rem; max-width: 96%; }
    .chat-saved__icon { width: 2.4rem; height: 2.4rem; }
    .chat-saved__title { font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-typing i { animation: none; }
    .chat-scroll { scroll-behavior: auto; }
    .chat-saved { animation: none; }
  }
</style>

<script>
  import { fetchEventSource } from '@microsoft/fetch-event-source';
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';
  import confetti from 'canvas-confetti';

  type Role = 'user' | 'assistant';
  interface Msg { role: Role; content: string; }

  class FriendlyError extends Error {}

  marked.setOptions({ breaks: true, gfm: true });

  const MAX_INPUT = 1000; // символов в одном сообщении
  const MAX_CONTEXT = 9000; // суммарно символов в истории — мягкий предохранитель

  function initChat(root: HTMLElement) {
    const cfgEl = root.querySelector<HTMLElement>('[data-chat-config]');
    if (!cfgEl) return;
    const cfg = JSON.parse(cfgEl.textContent || '{}');

    const messagesEl = root.querySelector<HTMLElement>('[data-messages]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')!;
    const sendBtn = root.querySelector<HTMLButtonElement>('[data-send]')!;
    const startersEl = root.querySelector<HTMLElement>('[data-starters]');
    const limitEl = root.querySelector<HTMLElement>('[data-limit]');
    const remainingEl = root.querySelector<HTMLElement>('[data-remaining]');
    const canvasEl = root.querySelector<HTMLCanvasElement>('[data-confetti]');

    const MAX = Number(cfg.maxMessages) || 10;
    const messages: Msg[] = [{ role: 'assistant', content: String(cfg.greeting || '') }];
    let userCount = 0;
    let streaming = false;
    let locked = false;

    const md = (text: string) =>
      DOMPurify.sanitize(marked.parse(text || '', { async: false }) as string);
    const scrollDown = () => { messagesEl.scrollTop = messagesEl.scrollHeight; };

    function bubble(role: Role | 'system'): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'chat-msg chat-msg--' + role;
      const body = document.createElement('div');
      body.className = 'chat-bubble';
      wrap.appendChild(body);
      messagesEl.appendChild(wrap);
      scrollDown();
      return body;
    }
    function systemNote(text: string) {
      const b = bubble('system');
      b.textContent = text;
    }

    function updateRemaining() {
      if (remainingEl) remainingEl.textContent = String(Math.max(0, MAX - userCount));
    }
    function setStreaming(v: boolean) {
      streaming = v;
      sendBtn.disabled = v || locked;
      sendBtn.classList.toggle('is-loading', v);
    }
    function lock() {
      locked = true;
      input.disabled = true;
      sendBtn.disabled = true;
      startersEl?.setAttribute('hidden', '');
      limitEl?.removeAttribute('hidden');
    }

    // --- Развязки: токены модели (на экране не видны, превращаются в карточки) ---
    // [[SAVED hours=NN money=NN note="..."]] — человек отказался от цели.
    // [[STAND note="..."]] — человек остался при своём (успех + конфетти).
    const SAVED_RE = /\[\[\s*SAVED([^\]]*)\]\]/i;
    const STAND_RE = /\[\[\s*STAND([^\]]*)\]\]/i;
    const attr = (raw: string, re: RegExp) => (raw.match(re) || [])[1] || '';
    function parseSaved(text: string) {
      const m = text.match(SAVED_RE);
      if (!m) return null;
      const num = (re: RegExp) => Number(attr(m[1], re)) || 0;
      return {
        hours: num(/hours?\s*=\s*(\d+)/i),
        money: num(/money\s*=\s*(\d+)/i),
        note: attr(m[1], /note\s*=\s*"([^"]*)"/i),
      };
    }
    function parseStand(text: string) {
      const m = text.match(STAND_RE);
      if (!m) return null;
      return { note: attr(m[1], /note\s*=\s*"([^"]*)"/i) };
    }
    // Убираем оба токена из видимого текста.
    const stripTokens = (text: string) => text.replace(SAVED_RE, '').replace(STAND_RE, '').trim();

    // Универсальная карточка-развязка (стекло) с иконкой из шаблона.
    function outcomeCard(opts: { variant: string; iconTpl: string; title: string; note?: string }) {
      const card = document.createElement('div');
      card.className = 'chat-saved' + (opts.variant ? ' ' + opts.variant : '');
      const icon = document.createElement('div');
      icon.className = 'chat-saved__icon';
      const tpl = root.querySelector(opts.iconTpl);
      if (tpl && 'content' in tpl) icon.appendChild((tpl as HTMLTemplateElement).content.cloneNode(true));
      const col = document.createElement('div');
      const title = document.createElement('div');
      title.className = 'chat-saved__title';
      title.textContent = opts.title;
      col.appendChild(title);
      if (opts.note) {
        const note = document.createElement('div');
        note.className = 'chat-saved__note';
        note.textContent = opts.note; // textContent — без HTML-инъекций из ответа модели
        col.appendChild(note);
      }
      card.append(icon, col);
      messagesEl.appendChild(card);
      scrollDown();
    }

    function celebrate(saved: { hours: number; money: number; note: string }) {
      const unit = cfg.counter?.unit || 'часов';
      const label = cfg.counter?.label || 'Сэкономлено';
      const money = saved.money ? ` и ${saved.money.toLocaleString('ru-RU')} ₽` : '';
      outcomeCard({
        variant: '',
        iconTpl: '[data-saved-icon]',
        title: `${label}: ${saved.hours} ${unit}${money}`,
        note: saved.note,
      });
      fireConfetti();
    }

    function standOvation(stand: { note: string }) {
      outcomeCard({
        variant: 'chat-saved--stand',
        iconTpl: '[data-stand-icon]',
        title: stand.note || 'Это твоё — иди и бери.',
        note: 'Ты не свернул, когда тебя настойчиво отговаривали. Это и есть твоё настоящее «зачем».',
      });
      fireConfetti();
    }

    // Конфетти в чате — на холсте поверх ленты (не ловит клики).
    function fireConfetti() {
      if (!canvasEl || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const shoot = confetti.create(canvasEl, { resize: true, useWorker: false });
      const colors = ['#0894ff', '#c959dd', '#ff2e54', '#ff9004'];
      shoot({ particleCount: 90, spread: 75, startVelocity: 38, origin: { y: 0.7 }, colors });
      setTimeout(() => shoot({ particleCount: 60, spread: 100, startVelocity: 30, origin: { x: 0.2, y: 0.8 }, colors }), 180);
      setTimeout(() => shoot({ particleCount: 60, spread: 100, startVelocity: 30, origin: { x: 0.8, y: 0.8 }, colors }), 320);
    }

    function autoGrow() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 160) + 'px';
    }

    async function send(raw: string) {
      let text = (raw || '').trim();
      if (!text || streaming || locked) return;
      if (text.length > MAX_INPUT) text = text.slice(0, MAX_INPUT);

      const ctxLen = messages.reduce((s, m) => s + m.content.length, 0) + text.length;
      if (ctxLen > MAX_CONTEXT) {
        systemNote('Разговор стал слишком длинным. Нажми «Начать заново».');
        lock();
        return;
      }

      startersEl?.setAttribute('hidden', '');

      messages.push({ role: 'user', content: text });
      bubble('user').textContent = text; // textContent — ввод пользователя без HTML
      userCount += 1;
      updateRemaining();
      input.value = '';
      autoGrow();

      const ab = bubble('assistant');
      ab.innerHTML = '<span class="chat-typing"><i></i><i></i><i></i></span>';
      setStreaming(true);

      let buffer = '';
      const ctrl = new AbortController();

      try {
        await fetchEventSource(cfg.apiBase + '/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ botId: cfg.botId, messages }),
          signal: ctrl.signal,
          openWhenHidden: true,
          async onopen(res) {
            const ct = res.headers.get('content-type') || '';
            if (res.ok && ct.includes('text/event-stream')) return;
            if (res.status === 429)
              throw new FriendlyError('Слишком много сообщений подряд. Передохни минутку и попробуй снова.');
            let msg = 'Бот сейчас недоступен. Попробуй чуть позже.';
            try { const j = await res.json(); if (j?.error) msg = j.error; } catch {}
            throw new FriendlyError(msg);
          },
          onmessage(ev) {
            if (ev.data === '[DONE]') { ctrl.abort(); return; }
            let d: any;
            try { d = JSON.parse(ev.data); } catch { return; }
            if (d.error) throw new FriendlyError(String(d.error));
            if (typeof d.delta === 'string') {
              buffer += d.delta;
              ab.innerHTML = md(stripTokens(buffer));
              scrollDown();
            }
          },
          onerror(err) { throw err; }, // не ретраить — пробрасываем наверх
        });
      } catch (err: any) {
        if (!(err && err.name === 'AbortError')) {
          const friendly = err instanceof FriendlyError ? err.message : 'Связь прервалась. Попробуй ещё раз.';
          if (!buffer) {
            ab.classList.add('is-error');
            ab.textContent = friendly;
          } else {
            systemNote(friendly);
          }
        }
      }

      const finalText = stripTokens(buffer);
      if (buffer) {
        ab.innerHTML = md(finalText || '…');
        messages.push({ role: 'assistant', content: finalText });
        const saved = parseSaved(buffer);
        const stand = parseStand(buffer);
        if (saved) celebrate(saved);
        else if (stand) standOvation(stand);
      } else if (!ab.classList.contains('is-error')) {
        ab.textContent = 'Хм, я завис. Попробуй переспросить.';
      }

      setStreaming(false);
      if (userCount >= MAX) lock();
      // сообщаем индикатору лимита под чатом, что был ответ — он обновит остаток
      window.dispatchEvent(new CustomEvent('chat:answered'));
    }

    // --- Слушатели ---
    form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(input.value); }
    });
    input.addEventListener('input', autoGrow);
    startersEl?.querySelectorAll<HTMLButtonElement>('[data-starter]').forEach((b) =>
      b.addEventListener('click', () => send(b.dataset.starter || ''))
    );
    root.querySelector('[data-restart]')?.addEventListener('click', () => location.reload());

    updateRemaining();
  }

  document.querySelectorAll<HTMLElement>('[data-chat]').forEach(initChat);
</script>
