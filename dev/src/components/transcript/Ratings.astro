---
import SectionHeading from './SectionHeading.astro';
import { ratingColor, ratingFill, isTopRating } from '../../lib/categories';

interface Rating {
  label: string;
  value: number;
  note?: string;
}
interface Props {
  ratings: Rating[];
  title?: string;
}
const { ratings, title = 'Оценка материала' } = Astro.props;

const avg = ratings.reduce((s, r) => s + r.value, 0) / ratings.length;
const avgPct = (avg / 5) * 100;
const avgTop = isTopRating(avg);
const avgColor = ratingColor(avg);
---

<section>
  <SectionHeading icon="star" title={title} hint="Чем выше — тем больше пользы на минуту" />

  <div
    class="border-border/60 bg-card/60 grid gap-8 rounded-2xl border p-6 backdrop-blur-sm md:grid-cols-[160px_1fr] md:p-8"
  >
    <!-- Средняя оценка -->
    <div class="flex flex-col items-center justify-center">
      <div class="rating-ring relative grid place-items-center" style={`--pct:${avgPct}; --ring-fill:${ratingFill(avg)}`}>
        <span
          class:list={['relative text-4xl font-bold tracking-tight', avgTop && 'text-gradient']}
          style={avgTop ? undefined : `color:${avgColor}`}
        >
          {avg.toFixed(1)}
        </span>
      </div>
      <p class="text-muted-foreground mt-3 text-xs font-semibold tracking-wide uppercase">
        средняя из 5
      </p>
    </div>

    <!-- Рубрики -->
    <div class="space-y-4">
      {
        ratings.map((r) => (
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[15px] font-medium">{r.label}</span>
              <span
                class:list={['text-sm font-semibold tabular-nums', isTopRating(r.value) && 'text-gradient']}
                style={isTopRating(r.value) ? undefined : `color:${ratingColor(r.value)}`}
              >
                {r.value.toFixed(1)}
              </span>
            </div>
            <div class="bg-muted mt-1.5 h-2.5 overflow-hidden rounded-full">
              <div
                class="rating-bar h-full rounded-full"
                style={`--val:${(r.value / 5) * 100}%; background: ${ratingFill(r.value)}`}
              />
            </div>
            {r.note && <p class="text-muted-foreground mt-1.5 text-[13px] leading-snug">{r.note}</p>}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rating-ring {
    width: 116px;
    height: 116px;
    border-radius: 50%;
    /* Верхний слой — трек на незаполненной дуге; нижний — заливка (цвет ИЛИ градиент) */
    background:
      conic-gradient(
        from -90deg,
        transparent calc(var(--pct) * 1%),
        color-mix(in oklch, var(--muted-foreground) 22%, transparent) 0
      ),
      var(--ring-fill, var(--primary));
    animation: ring-fill 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .rating-ring::before {
    content: '';
    position: absolute;
    inset: 9px;
    border-radius: 50%;
    background: var(--card);
  }
  @property --pct {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
  @keyframes ring-fill {
    from {
      --pct: 0;
    }
  }
  .rating-bar {
    width: var(--val);
    animation: grow-bar 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes grow-bar {
    from {
      width: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rating-ring,
    .rating-bar {
      animation: none;
    }
  }
</style>
