---
import SectionHeading from './SectionHeading.astro';
import Timecode from './Timecode.astro';
import { Icon } from '@/components/ui/icon';

interface Node {
  title: string;
  detail?: string;
  t?: number;
  type?: 'premise' | 'argument' | 'example' | 'conclusion';
}
interface Props {
  nodes: Node[];
  url: string;
  hint?: string;
}
const { nodes, url, hint = 'Как устроена аргументация материала — пройди по шагам' } = Astro.props;

const TYPES = {
  premise: { label: 'Предпосылка', color: '#0894ff' },
  argument: { label: 'Аргумент', color: '#c959dd' },
  example: { label: 'Пример', color: '#ff2e54' },
  conclusion: { label: 'Вывод', color: '#ff9004' },
} as const;

const used = [...new Set(nodes.map((n) => n.type).filter(Boolean))] as (keyof typeof TYPES)[];
---

<section>
  <SectionHeading
    icon="workflow"
    title="Логика повествования"
    hint={hint}
  />

  {
    used.length > 0 && (
      <div class="mb-6 flex flex-wrap gap-x-4 gap-y-2">
        {used.map((t) => (
          <span class="text-muted-foreground inline-flex items-center gap-1.5 text-[13px] font-medium">
            <span class="size-2.5 rounded-full" style={`background:${TYPES[t].color}`} />
            {TYPES[t].label}
          </span>
        ))}
      </div>
    )
  }

  <ol class="flow relative space-y-3">
    {
      nodes.map((n) => {
        const color = n.type ? TYPES[n.type].color : 'var(--primary)';
        const Wrap = n.detail ? 'details' : 'div';
        const Head = n.detail ? 'summary' : 'div';
        const headClass = `flow-head flex list-none items-center gap-3 p-4 select-none${n.detail ? ' cursor-pointer' : ''}`;
        return (
          <li class="flow-node relative pl-10">
            <span class="flow-dot" style={`--dot:${color}`} />
            <Wrap class="flow-card group border-border/60 bg-card/60 overflow-hidden rounded-xl border backdrop-blur-sm">
              <Head class={headClass}>
                {n.type && (
                  <span
                    class="shrink-0 rounded-md px-2 py-0.5 text-[11px] font-semibold tracking-wide text-white uppercase"
                    style={`background:${color}`}
                  >
                    {TYPES[n.type].label}
                  </span>
                )}
                <span class="flex-1 text-[15px] leading-snug font-medium">{n.title}</span>
                {typeof n.t === 'number' && <Timecode t={n.t} url={url} />}
                {n.detail && (
                  <Icon
                    name="chevron-down"
                    class="text-muted-foreground size-4 shrink-0 transition-transform duration-300 group-open:rotate-180"
                  />
                )}
              </Head>
              {n.detail && (
                <p class="text-muted-foreground border-border/50 border-t px-4 py-3.5 text-[14px] leading-relaxed">
                  {n.detail}
                </p>
              )}
            </Wrap>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .flow::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.6875rem; /* центр точки (pl-10=2.5rem, dot 18px @ left .375rem) */
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklch, var(--border) 100%, transparent) 8%,
      var(--border) 92%,
      transparent
    );
  }
  .flow-dot {
    position: absolute;
    left: 0.375rem;
    top: 1.1rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--dot) 18%, transparent);
  }
  /* details summary без стандартного маркера */
  .flow-card > summary::-webkit-details-marker {
    display: none;
  }
  details.flow-card > summary:hover {
    background: color-mix(in oklch, var(--accent) 60%, transparent);
  }
</style>
