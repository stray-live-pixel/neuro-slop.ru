---
import SectionHeading from './SectionHeading.astro';

interface Step {
  step: string;
  detail?: string;
}
interface Props {
  steps: Step[];
  storageKey: string;
}
const { steps, storageKey } = Astro.props;
---

<section data-plan data-key={`nsplan:${storageKey}`}>
  <SectionHeading
    icon="rocket"
    title="План внедрения"
    hint="С чего начать — отмечай шаги, прогресс сохранится"
  />

  <div class="border-border/60 bg-card/60 rounded-2xl border p-5 backdrop-blur-sm md:p-7">
    <div class="mb-5">
      <div class="bg-muted h-2 overflow-hidden rounded-full">
        <div
          class="plan-bar h-full rounded-full transition-[width] duration-500"
          style="width:0%; background: var(--gradient-brand)"
        >
        </div>
      </div>
      <p class="text-muted-foreground mt-2 text-[13px] font-medium">
        Выполнено <span data-done>0</span> из {steps.length}
      </p>
    </div>

    <ol class="space-y-2.5">
      {
        steps.map((s, i) => (
          <li>
            <label class="plan-item group hover:bg-accent/50 flex cursor-pointer items-start gap-3 rounded-xl p-3 transition-colors">
              <input
                type="checkbox"
                class="plan-check peer sr-only"
                data-i={i}
              />
              <span class="plan-box border-border text-primary-foreground mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-md border-2 transition-colors">
                <svg
                  class="plan-tick size-3.5 opacity-0 transition-opacity"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="plan-step block text-[15px] leading-snug font-medium transition-colors">
                  <span class="text-muted-foreground mr-1 font-semibold">Шаг {i + 1}.</span>
                  {s.step}
                </span>
                {s.detail && (
                  <span class="text-muted-foreground mt-1 block text-[14px] leading-relaxed">
                    {s.detail}
                  </span>
                )}
              </span>
            </label>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  function initPlan(root: HTMLElement) {
    const key = root.dataset.key!;
    const checks = Array.from(root.querySelectorAll<HTMLInputElement>('.plan-check'));
    const bar = root.querySelector<HTMLElement>('.plan-bar')!;
    const doneEl = root.querySelector<HTMLElement>('[data-done]')!;
    const total = checks.length;

    let saved: number[] = [];
    try {
      saved = JSON.parse(localStorage.getItem(key) ?? '[]');
    } catch {
      saved = [];
    }

    function render() {
      const done = checks.filter((c) => c.checked).length;
      doneEl.textContent = String(done);
      bar.style.width = total ? `${(done / total) * 100}%` : '0%';
    }

    checks.forEach((c, i) => {
      c.checked = saved.includes(i);
      c.addEventListener('change', () => {
        const picked = checks.map((x, idx) => (x.checked ? idx : -1)).filter((x) => x >= 0);
        try {
          localStorage.setItem(key, JSON.stringify(picked));
        } catch {
          /* приватный режим — просто не сохраняем */
        }
        render();
      });
    });

    render();
  }

  document.querySelectorAll<HTMLElement>('[data-plan]').forEach(initPlan);
</script>

<style>
  .plan-check:checked + .plan-box {
    background: var(--primary);
    border-color: var(--primary);
  }
  .plan-check:checked + .plan-box .plan-tick {
    opacity: 1;
  }
  .plan-check:checked ~ span .plan-step {
    color: var(--muted-foreground);
    text-decoration: line-through;
    text-decoration-color: color-mix(in oklch, var(--muted-foreground) 50%, transparent);
  }
  .plan-check:focus-visible + .plan-box {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
</style>
