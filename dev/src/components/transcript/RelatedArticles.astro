---
import SectionHeading from './SectionHeading.astro';
import { Icon } from '@/components/ui/icon';
import { TRANSCRIPTS_SECTION } from '../../lib/categories';

interface Item {
  href: string;
  title: string;
  tldr: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section>
      <SectionHeading icon="scroll-text" title="Похожие расшифровки" />
      <div class="grid gap-4 sm:grid-cols-2">
        {items.map((it) => (
          <a
            href={it.href}
            class="glow-card group border-border/60 bg-card/60 flex flex-col gap-2 rounded-2xl border p-5 backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
          >
            <span
              class="inline-flex w-fit items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[12px] font-semibold text-white"
              style={`background: ${TRANSCRIPTS_SECTION.gradient}`}
            >
              <Icon name="scroll-text" class="size-3" />
              Расшифровка
            </span>
            <h3 class="text-[16px] leading-snug font-semibold tracking-tight">{it.title}</h3>
            <p class="text-muted-foreground line-clamp-2 text-[14px] leading-relaxed">{it.tldr}</p>
            <span class="text-primary mt-auto pt-1 text-sm font-medium opacity-0 transition-opacity group-hover:opacity-100">
              Читать →
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}
