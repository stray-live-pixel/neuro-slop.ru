---
import { Icon } from '@/components/ui/icon';

interface Item {
  id: string;
  label: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

{/* Прогресс чтения — тонкая полоса поверх шапки */}
<div
  data-reading-progress
  class="fixed inset-x-0 top-0 z-[60] h-[3px] origin-left scale-x-0 transition-transform duration-75"
  style="background: var(--gradient-brand)"
>
</div>

{
  items.length > 1 && (
    <nav data-toc aria-label="Содержание статьи">
      {/* Боковой рельс — только на сверхшироких экранах */}
      <ul class="fixed top-1/2 right-6 z-30 hidden max-w-[180px] -translate-y-1/2 space-y-1 2xl:block">
        {items.map((it) => (
          <li>
            <a
              href={`#${it.id}`}
              data-toc-link={it.id}
              class="toc-rail-link text-muted-foreground hover:text-foreground block border-r-2 border-transparent py-1 pr-3 text-right text-[13px] leading-snug transition-colors"
            >
              {it.label}
            </a>
          </li>
        ))}
      </ul>

      {/* Плавающая кнопка «Содержание» + панель — на остальных экранах */}
      <div class="fixed right-5 bottom-5 z-40 2xl:hidden">
        <div
          data-toc-panel
          hidden
          class="border-border/60 bg-card/95 absolute right-0 bottom-full mb-3 max-h-[60vh] w-64 overflow-auto rounded-2xl border p-2 shadow-xl backdrop-blur-md"
        >
          <p class="text-muted-foreground px-3 pt-1.5 pb-2 text-xs font-semibold tracking-wide uppercase">
            Содержание
          </p>
          <ul class="space-y-0.5">
            {items.map((it) => (
              <li>
                <a
                  href={`#${it.id}`}
                  data-toc-link={it.id}
                  class="toc-panel-link text-muted-foreground hover:bg-accent hover:text-foreground block rounded-lg px-3 py-2 text-[14px] leading-snug transition-colors"
                >
                  {it.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <button
          type="button"
          data-toc-toggle
          aria-expanded="false"
          aria-label="Содержание статьи"
          class="border-border/60 bg-card/90 text-foreground hover:bg-accent flex size-12 items-center justify-center rounded-full border shadow-lg backdrop-blur-md transition-colors"
        >
          <Icon name="list" class="size-5" />
        </button>
      </div>
    </nav>
  )
}

<style>
  .toc-rail-link.is-active {
    color: var(--foreground);
    font-weight: 600;
    border-color: var(--primary);
  }
  .toc-panel-link.is-active {
    color: var(--foreground);
    font-weight: 600;
    background: color-mix(in oklch, var(--primary) 12%, transparent);
  }
</style>

<script>
  // Прогресс чтения
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  let ticking = false;
  function updateProgress() {
    ticking = false;
    if (!bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    bar.style.transform = `scaleX(${ratio})`;
  }

  // Активная секция в оглавлении
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const sections = links
    .map((l) => l.dataset.tocLink)
    .filter((v, i, a) => v && a.indexOf(v) === i)
    .map((id) => document.getElementById(id!))
    .filter((el): el is HTMLElement => !!el);

  function updateActive() {
    let currentId = sections[0]?.id ?? '';
    for (const sec of sections) {
      if (sec.getBoundingClientRect().top <= 140) currentId = sec.id;
      else break;
    }
    links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === currentId));
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => {
        updateProgress();
        updateActive();
      });
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  updateProgress();
  updateActive();

  // Плавающая панель
  const toggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-toc-panel]');
  function setPanel(open: boolean) {
    if (!panel || !toggle) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
  }
  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setPanel(panel?.hidden ?? false);
  });
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement)?.closest('a')) setPanel(false);
  });
  document.addEventListener('click', (e) => {
    if (panel && !panel.hidden && !(e.target as HTMLElement)?.closest('[data-toc]')) setPanel(false);
  });
</script>
