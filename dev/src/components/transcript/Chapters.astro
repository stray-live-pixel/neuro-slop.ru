---
import { Icon } from '@/components/ui/icon';
import { formatTimecode, videoTimeUrl } from '../../lib/video';

interface Chapter {
  t: number;
  title: string;
  detail?: string;
}
interface Props {
  chapters: Chapter[];
  url: string;
  label?: string;
}
const { chapters, url, label = 'Главы — нажми, чтобы перейти к моменту' } = Astro.props;
const sorted = [...chapters].sort((a, b) => a.t - b.t);
---

<details class="ns-chapters group border-border/60 bg-card/50 mt-4 rounded-2xl border backdrop-blur-sm">
  <summary
    class="text-muted-foreground flex select-none items-center gap-2 px-4 py-3 text-xs font-semibold tracking-wide uppercase"
  >
    <Icon name="chevron-down" class="size-4 transition-transform duration-300 group-open:rotate-180" />
    <span class="min-w-0 flex-1 truncate normal-case">{label}</span>
    <span class="text-primary bg-primary/10 inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[11px] tabular-nums">
      {sorted.length}
    </span>
  </summary>
  <ol class="divide-border/50 border-border/50 divide-y border-t">
    {
      sorted.map((c) => (
        <li>
          <a
            href={videoTimeUrl(url, c.t)}
            target="_blank"
            rel="noopener"
            class="hover:bg-accent/50 flex items-start gap-3 px-4 py-3 transition-colors"
          >
            <span class="text-primary bg-primary/10 mt-0.5 inline-flex shrink-0 items-center rounded-md px-1.5 py-0.5 text-[12px] font-semibold tabular-nums">
              {formatTimecode(c.t)}
            </span>
            <span class="min-w-0">
              <span class="block text-[15px] leading-snug font-medium">{c.title}</span>
              {c.detail && (
                <span class="text-muted-foreground mt-0.5 block text-[13px] leading-snug">
                  {c.detail}
                </span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</details>
