---
import { Icon } from '@/components/ui/icon';

interface Props {
  icon: string;
  title: string;
  hint?: string;
}
const { icon, title, hint } = Astro.props;
---

<div class="mb-6 flex items-center gap-3">
  <span class="bg-primary/10 text-primary flex size-10 shrink-0 items-center justify-center rounded-xl">
    <Icon name={icon} class="size-5" />
  </span>
  <div>
    <h2 class="text-[clamp(1.4rem,3vw,1.9rem)] leading-tight font-bold tracking-tight">{title}</h2>
    {hint && <p class="text-muted-foreground mt-0.5 text-sm">{hint}</p>}
  </div>
</div>
