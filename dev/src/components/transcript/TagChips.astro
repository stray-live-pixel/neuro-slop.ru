---
import { Icon } from '@/components/ui/icon';
import { tagLabel } from '../../lib/tags';

interface Props {
  tags: string[];
  // link — чипы ведут на /transcripts/?tag=<slug>; plain — просто метки
  variant?: 'link' | 'plain';
  showIcon?: boolean;
}
const { tags, variant = 'link', showIcon = true } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((slug) =>
      variant === 'link' ? (
        <a
          href={`/transcripts/?tag=${encodeURIComponent(slug)}`}
          class="bg-card/60 border-border/60 text-foreground/80 hover:border-primary/50 hover:text-foreground inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-medium backdrop-blur-sm transition-colors"
        >
          {showIcon && <Icon name="tag" class="size-3.5 opacity-60" />}
          {tagLabel(slug)}
        </a>
      ) : (
        <span class="bg-accent text-accent-foreground inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium">
          {tagLabel(slug)}
        </span>
      )
    )
  }
</div>
