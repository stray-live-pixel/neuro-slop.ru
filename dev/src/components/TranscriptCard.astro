---
import type { CollectionEntry } from 'astro:content';
import { Icon } from '@/components/ui/icon';
import { formatDate, TRANSCRIPTS_SECTION } from '../lib/categories';
import { tagLabel } from '../lib/tags';

interface Props {
  entry: CollectionEntry<'transcripts'>;
}
const { entry } = Astro.props;
const d = entry.data;
const avg = d.ratings.reduce((s, r) => s + r.value, 0) / d.ratings.length;
const tags = d.tags.slice(0, 3);
---

<a
  class="glow-card group border-border/60 relative flex min-h-[230px] flex-col justify-between gap-6 overflow-hidden rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl md:min-h-[250px] md:p-8"
  href={`/transcripts/${entry.id}/`}
  data-tags={d.tags.join(' ')}
>
  {
    d.cover ? (
      <img
        src={d.cover}
        alt=""
        loading="lazy"
        class="absolute inset-0 h-full w-full scale-[1.06] object-cover blur-[8px] transition-transform duration-700 group-hover:scale-[1.1]"
      />
    ) : (
      <div class="absolute inset-0" style={`background: ${TRANSCRIPTS_SECTION.gradient}`} />
    )
  }
  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-black/30"></div>

  <p class="relative flex items-center justify-between gap-3 text-[13px]">
    <span
      class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-semibold text-white shadow-sm"
      style={`background: ${TRANSCRIPTS_SECTION.gradient}`}
    >
      <Icon name="scroll-text" class="size-3.5" />
      Расшифровка
    </span>
    <span
      class="inline-flex items-center gap-1 rounded-full bg-white/15 px-2.5 py-1 font-semibold text-white backdrop-blur-sm"
    >
      <Icon name="star" class="size-3.5" />
      {avg.toFixed(1)}
    </span>
  </p>

  <span class="relative block">
    <h3 class="text-[clamp(1.35rem,2.2vw,1.7rem)] leading-tight font-bold tracking-tight text-white">
      {d.title}
    </h3>
    <span class="mt-2 line-clamp-3 block max-w-[60ch] text-[15px] leading-normal text-white/80">
      {d.tldr}
    </span>
    <span class="mt-3 flex flex-wrap items-center gap-1.5">
      {
        tags.map((t) => (
          <span class="rounded-full bg-white/15 px-2.5 py-0.5 text-[12px] font-medium text-white/90 backdrop-blur-sm">
            {tagLabel(t)}
          </span>
        ))
      }
      <time datetime={d.date.toISOString()} class="ml-auto text-[13px] font-medium text-white/65">
        {formatDate(d.date)}
      </time>
    </span>
  </span>
</a>
